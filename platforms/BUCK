load("@prelude//platforms:defs.bzl", "host_configuration")
load(":defs.bzl", "re_execution_platform")

# OS-generic limited-hybrid RE platform (linux/mac sweeps, compose rig).
# Requires the pinned buck2 (host_configuration uses newer prelude API).
re_execution_platform(
    name = "re-exec",
    cpu_configuration = host_configuration.cpu,
    local_enabled = True,
    os_configuration = host_configuration.os,
    use_limited_hybrid = True,
    visibility = ["PUBLIC"],
)

# Selected by writing `[build] execution_platforms = fixups//platforms:re-exec-win`
# into .buckconfig.local (sweep-re.yml does this). Default builds are untouched.
# Constraints hardcoded (not host_configuration) — this platform only exists
# for the x86_64 windows sweep runners.
# Limited hybrid: compiles go remote; only local_only actions (the prelude's
# msvc/vswhere discovery) run beside buck2 — negligible memory on the driver.
re_execution_platform(
    name = "re-exec-win",
    cpu_configuration = "prelude//cpu:x86_64",
    local_enabled = True,
    os_configuration = "prelude//os:windows",
    use_limited_hybrid = True,
    use_windows_path_separators = True,
    visibility = ["PUBLIC"],
)
